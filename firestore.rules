rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isOwner(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function isAdminEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'nhgb2605@gmail.com';
    }

    function isAdmin() {
      return isAdminEmail();
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser(data, uid) {
      return data.uid == uid
        && data.email is string && data.email.size() <= 254
        && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 80
        && data.profile is map
        && data.level is number && data.level >= 1 && data.level <= 999
        && data.exp is number && data.exp >= 0
        && data.gold is number && data.gold >= 0 && data.gold <= 1000000000000
        && data.dopiCoins is number && data.dopiCoins >= 0 && data.dopiCoins <= 1000000000
        && data.totalRechargedCoins is number && data.totalRechargedCoins >= 0
        && data.vipLevel is number && data.vipLevel >= 0 && data.vipLevel <= 20
        && data.storageCapacity is number && data.storageCapacity >= 20 && data.storageCapacity <= 50000
        && data.farmPlots is list && data.farmPlots.size() >= 1 && data.farmPlots.size() <= 50
        && data.factories is list && data.factories.size() >= 1 && data.factories.size() <= 20
        && data.inventory is map
        && data.friends is list && data.friends.size() <= 200
        && data.dailyQuests is list && data.dailyQuests.size() <= 30
        && data.npcOrders is list && data.npcOrders.size() <= 20
        && data.updatedAt is number;
    }

    function isValidP2PCompany(data, ownerUid) {
      return data.ownerUid == ownerUid
        && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 80
        && data.level is number && data.level >= 1 && data.level <= 999
        && data.wealthScore is number && data.wealthScore >= 0
        && data.plotCount is number && data.plotCount >= 1 && data.plotCount <= 50
        && data.employeeCount is number && data.employeeCount >= 0 && data.employeeCount <= 100
        && data.vehicleCount is number && data.vehicleCount >= 0 && data.vehicleCount <= 50
        && data.recentOrders is number && data.recentOrders >= 0
        && data.sharePrice is number && data.sharePrice >= 1 && data.sharePrice <= 1000000000
        && data.totalShares is number && data.totalShares == 1000
        && data.availableShares is number && data.availableShares >= 0 && data.availableShares <= 400
        && data.dividendRate is number && data.dividendRate >= 5 && data.dividendRate <= 10
        && data.dividendPool is number && data.dividendPool >= 0 && data.dividendPool <= 100000000000
        && data.creditRating in ['AAA', 'AA', 'A', 'B', 'C']
        && data.lastActiveAt is number
        && data.isListed is bool;
    }

    function isValidPublicFarm(data, uid) {
      return data.uid == uid
        && data.isPublic is bool
        && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 80
        && data.displayName is string && data.displayName.size() <= 80
        && data.avatarEmoji is string && data.avatarEmoji.size() <= 32
        && data.level is number && data.level >= 1 && data.level <= 999
        && data.vipLevel is number && data.vipLevel >= 0 && data.vipLevel <= 20
        && data.farmPlots is list && data.farmPlots.size() >= 1 && data.farmPlots.size() <= 50
        && data.updatedAt is number;
    }

    function isValidEmailDir(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 80
        && data.displayName is string && data.displayName.size() <= 80
        && data.avatarEmoji is string && data.avatarEmoji.size() <= 32
        && data.level is number && data.level >= 1 && data.level <= 999
        && data.vipLevel is number && data.vipLevel >= 0 && data.vipLevel <= 20;
    }

    function isValidRedeemCode(data, codeId) {
      return data.code == codeId
        && data.amount is number && data.amount >= 1 && data.amount <= 1000000
        && data.maxUses is number && data.maxUses >= 1 && data.maxUses <= 500
        && data.usedCount is number && data.usedCount >= 0 && data.usedCount <= data.maxUses
        && data.usedBy is list && data.usedBy.size() <= 500
        && data.expiresAt is number
        && data.createdBy is string && data.createdBy.size() <= 254
        && data.createdAt is number
        && data.isActive is bool;
    }

    function isValidTopupRequest(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 80
        && data.amount is number && data.amount >= 10 && data.amount <= 1000000
        && data.transferCode is string && data.transferCode.size() >= 6 && data.transferCode.size() <= 40
        && data.note is string && data.note.size() <= 300
        && data.status in ['pending', 'approved', 'rejected']
        && data.rejectReason is string && data.rejectReason.size() <= 300
        && data.createdAt is number
        && data.processedAt is number;
    }

    function isValidMarketListing(data) {
      return data.sellerUid is string && data.sellerUid.size() >= 1 && data.sellerUid.size() <= 128
        && data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 80
        && data.sellerVipLevel is number && data.sellerVipLevel >= 0 && data.sellerVipLevel <= 20
        && data.itemId is string && data.itemId.size() >= 1 && data.itemId.size() <= 64
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 999
        && data.currency in ['gold', 'coins']
        && data.price is number && data.price >= 1 && data.price <= 100000000
        && data.status in ['active', 'sold', 'cancelled']
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidFriendRequest(data) {
      return data.fromUid is string && data.fromUid.size() >= 1 && data.fromUid.size() <= 128
        && data.fromEmail is string && data.fromEmail.size() <= 254
        && data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 80
        && data.toUid is string && data.toUid.size() >= 1 && data.toUid.size() <= 128
        && data.fromUid != data.toUid
        && data.status in ['pending', 'accepted', 'rejected']
        && data.createdAt is number;
    }

    function isValidFriendMessage(data) {
      return data.chatId is string && data.chatId.size() >= 3 && data.chatId.size() <= 260
        && data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.senderAvatar is string && data.senderAvatar.size() <= 32
        && data.recipientUid is string && data.recipientUid.size() >= 1 && data.recipientUid.size() <= 128
        && data.senderUid != data.recipientUid
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 400
        && data.createdAt is number;
    }

    // ===============================================================
    // Collection Rules: users/{uid}
    // ===============================================================
    match /users/{uid} {
      allow get: if isValidId(uid) && isSignedIn();
      allow list: if isAdmin();

      allow create: if isValidId(uid)
        && isOwner(uid)
        && isValidUser(incoming(), uid);

      allow update: if isValidId(uid)
        && isVerified()
        && (
          (
            // Owner updating their own game state
            isOwner(uid)
            && isValidUser(incoming(), uid)
          )
          || (
            // Admin approving top-up requests or managing user state
            isAdmin()
          )
          || (
            // Cross-user atomic Gold credit (P2P market sale or P2P IPO share purchase)
            request.auth.uid != uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['gold', 'updatedAt'])
            && incoming().gold is number
            && incoming().gold >= existing().gold
          )
          || (
            // Cross-user atomic DOPI Coins credit (P2P market sale in coins)
            request.auth.uid != uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['dopiCoins', 'updatedAt'])
            && incoming().dopiCoins is number
            && incoming().dopiCoins >= existing().dopiCoins
          )
          || (
            // Cross-user mutual friend acceptance
            request.auth.uid != uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['friends', 'updatedAt'])
            && incoming().friends is list
            && incoming().friends.size() <= 200
          )
        );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // Collection Rules: p2p_companies/{ownerUid}
    // ===============================================================
    match /p2p_companies/{ownerUid} {
      allow get, list: if isSignedIn();

      allow create: if isValidId(ownerUid)
        && isVerified()
        && isValidP2PCompany(incoming(), ownerUid);

      allow update: if isValidId(ownerUid)
        && isVerified()
        && isValidP2PCompany(incoming(), ownerUid)
        && (
          isOwner(ownerUid)
          || isAdmin()
          || (
            // Investor buying or selling P2P shares or claiming dividends
            incoming().diff(existing()).affectedKeys().hasAny(['availableShares', 'dividendPool'])
          )
        );

      allow delete: if isOwner(ownerUid) || isAdmin();
    }

    // ===============================================================
    // Collection Rules: public_farms/{uid}
    // ===============================================================
    match /public_farms/{uid} {
      allow get: if isValidId(uid) && isSignedIn();
      allow list: if isSignedIn();

      allow create: if isValidId(uid)
        && (isOwner(uid) || isAdmin())
        && isValidPublicFarm(incoming(), uid);

      allow update: if isValidId(uid)
        && isVerified()
        && isValidPublicFarm(incoming(), uid)
        && (
          isOwner(uid)
          || isAdmin()
          || (
            // Friend watering plot on public farm
            request.auth.uid != uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['farmPlots', 'updatedAt'])
          )
        );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // Collection Rules: email_directory/{emailKey}
    // ===============================================================
    match /email_directory/{emailKey} {
      allow get: if isValidId(emailKey) && isSignedIn();
      allow list: if isSignedIn();

      allow create, update: if isValidId(emailKey)
        && isVerified()
        && isValidEmailDir(incoming())
        && incoming().uid == request.auth.uid;

      allow delete: if isAdmin();
    }

    // ===============================================================
    // Collection Rules: redeem_codes/{codeId}
    // ===============================================================
    match /redeem_codes/{codeId} {
      allow get: if isValidId(codeId) && isSignedIn();
      allow list: if isAdminEmail();

      allow create: if isValidId(codeId)
        && isAdminEmail()
        && isValidRedeemCode(incoming(), codeId);

      allow update: if isValidId(codeId)
        && isVerified()
        && isValidRedeemCode(incoming(), codeId)
        && (
          isAdminEmail()
          || (
            existing().isActive == true
            && incoming().usedCount == existing().usedCount + 1
            && incoming().usedBy.size() == existing().usedBy.size() + 1
            && incoming().usedBy.hasAll(existing().usedBy)
            && !(request.auth.uid in existing().usedBy)
            && (request.auth.uid in incoming().usedBy)
          )
        );

      allow delete: if isValidId(codeId) && isAdminEmail();
    }

    // ===============================================================
    // Collection Rules: topup_requests/{reqId}
    // ===============================================================
    match /topup_requests/{reqId} {
      allow get: if isValidId(reqId) && isSignedIn() && (
        resource.data.uid == request.auth.uid || isAdminEmail()
      );
      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid || isAdminEmail()
      );

      allow create: if isValidId(reqId)
        && isVerified()
        && isValidTopupRequest(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending';

      allow update: if isValidId(reqId)
        && isAdminEmail()
        && isValidTopupRequest(incoming());

      allow delete: if isValidId(reqId) && isAdminEmail();
    }

    // ===============================================================
    // Collection Rules: market_listings/{listingId}
    // ===============================================================
    match /market_listings/{listingId} {
      allow get, list: if isSignedIn();

      allow create: if isValidId(listingId)
        && isVerified()
        && isValidMarketListing(incoming())
        && incoming().sellerUid == request.auth.uid
        && incoming().status == 'active';

      allow update: if isValidId(listingId)
        && isVerified()
        && isValidMarketListing(incoming())
        && existing().status == 'active'
        && (
          (
            // Seller cancelling their active listing
            existing().sellerUid == request.auth.uid
            && incoming().status == 'cancelled'
          )
          || (
            // Buyer purchasing an active listing
            existing().sellerUid != request.auth.uid
            && incoming().status == 'sold'
          )
        );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // Collection Rules: friend_requests/{reqId}
    // ===============================================================
    match /friend_requests/{reqId} {
      allow get: if isValidId(reqId) && isSignedIn();
      allow list: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
        || isAdminEmail()
      );

      allow create: if isValidId(reqId)
        && isVerified()
        && isValidFriendRequest(incoming())
        && incoming().fromUid == request.auth.uid
        && incoming().status == 'pending';

      allow update: if isValidId(reqId)
        && isVerified()
        && isValidFriendRequest(incoming())
        && (
          (
            // Receiver accepting or rejecting
            existing().toUid == request.auth.uid
            && incoming().status in ['accepted', 'rejected']
          )
          || (
            // Sender re-sending a request
            incoming().fromUid == request.auth.uid
            && incoming().status == 'pending'
          )
        );

      allow delete: if isValidId(reqId) && isSignedIn() && (
        existing().fromUid == request.auth.uid
        || existing().toUid == request.auth.uid
        || isAdmin()
      );
    }

    // ===============================================================
    // Collection Rules: friend_messages/{msgId}
    // ===============================================================
    match /friend_messages/{msgId} {
      allow get, list: if isSignedIn();

      allow create: if isValidId(msgId)
        && isVerified()
        && isValidFriendMessage(incoming())
        && incoming().senderUid == request.auth.uid;

      allow delete: if isValidId(msgId) && isSignedIn() && (
        existing().senderUid == request.auth.uid
        || existing().recipientUid == request.auth.uid
        || isAdmin()
      );
    }
  }
}
